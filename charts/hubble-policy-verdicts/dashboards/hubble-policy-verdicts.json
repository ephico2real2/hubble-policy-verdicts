        },
        "text": {
          "titleSize": 14,
          "valueSize": 16
        }
      }
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "Top 10 destinations with dropped packets",
      "description": "Whose traffic is being dropped on the way in (any reason), now. The reason is on the timeseries to the left.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
