      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, sum(rate(hubble_drop_total{cluster=~\"$cluster\", ${role}=~\"$namespace\"}[$__rate_interval])) by (destination))",
          "legendFormat": "{{destination}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "showUnfilled": true,
        "reduceOptions": {
