{
  "uid": "hubble-policy-verdicts",
  "title": "Hubble / Policy Verdicts (Namespace)",
  "tags": [
    "cilium",
    "hubble",
    "policy",
    "network-policy"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Data Source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(hubble_policy_verdicts_total, cluster)",
          "refId": "c"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      },
      {
        "type": "custom",
        "name": "role",
        "label": "namespace is the",
        "description": "Which side of the verdict the namespace filter applies to: the destination (what came INTO the namespace and what the policy did \u2014 the default) or the source (what the namespace's workloads tried to reach). Demo 29 Part 8: an egress drop that leaves the namespace is on the source side only.",
        "query": "destination : destination_namespace, source : source_namespace",
        "current": {
          "selected": true,
          "text": "destination",
          "value": "destination_namespace"
        },
        "options": [
          {
            "selected": true,
            "text": "destination",
            "value": "destination_namespace"
          },
          {
            "selected": false,
            "text": "source",
            "value": "source_namespace"
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(hubble_policy_verdicts_total{cluster=~\"$cluster\"}, $role)",
          "refId": "n"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "definition": "label_values(hubble_policy_verdicts_total{cluster=~\"$cluster\"}, $role)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Audited (policy evaluated, not enforced) \u2014 in range",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(hubble_policy_verdicts_total{cluster=~\"$cluster\", ${role}=~\"$namespace\", action=\"audit\"}[$__range]))",
          "legendFormat": "audit",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "noValue": "0"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Forwarded by an allow rule \u2014 in range",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(hubble_policy_verdicts_total{cluster=~\"$cluster\", ${role}=~\"$namespace\", action=\"forwarded\"}[$__range]))",
          "legendFormat": "forwarded",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "noValue": "0"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dropped by policy \u2014 in range",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(hubble_policy_verdicts_total{cluster=~\"$cluster\", ${role}=~\"$namespace\", action=\"dropped\"}[$__range]))",
          "legendFormat": "dropped",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "0"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Still audited (last 5 min): source \u2192 destination pairs",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(sum(rate(hubble_policy_verdicts_total{cluster=~\"$cluster\", ${role}=~\"$namespace\", action=\"audit\"}[5m])) by (source, destination) > 0)",
          "legendFormat": "endpoints",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "none",
                  "index": 0
                }
              }
            }
          ]
        }
      },
      "description": "A source \u2192 destination pair that produced audit verdicts in the last 5 minutes has an endpoint in PolicyAuditMode: policy is evaluated and reported, nothing is blocked yet. Green 'none' means every endpoint in view is enforcing (or nothing is selected by a policy at all \u2014 the audit and dropped counters say which). Pairs, not workloads, so the count reads the same whether the namespace is the destination or the source. The query is INSTANT: a stat over a range series reduces lastNotNull and would show the last value from the audit window long after audit was switched off \u2014 measured on the first capture."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Policy verdicts per second, by action",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(hubble_policy_verdicts_total{cluster=~\"$cluster\", ${role}=~\"$namespace\"}[$__rate_interval])) by (action)",
          "legendFormat": "{{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "audit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "forwarded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dropped"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "description": "hubble_policy_verdicts_total \u2014 Hubble's `policy` dynamic metric (the chart README). An audit line rising while forwarded/dropped stay flat is the observe-first phase; dropped appearing after audit vanishes is enforcement."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Verdicts per second, by source \u2192 destination and action",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(hubble_policy_verdicts_total{cluster=~\"$cluster\", ${role}=~\"$namespace\"}[$__rate_interval])) by (source, destination, direction, action)",
          "legendFormat": "{{source}} \u2192 {{destination}} ({{direction}}) {{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Who talked to whom, and what the policy did \u2014 totals in range",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(hubble_policy_verdicts_total{cluster=~\"$cluster\", ${role}=~\"$namespace\"}[$__range])) by (cluster, source, destination, direction, action, match)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "verdicts"
            },
            "indexByName": {
              "cluster": 0,
              "source": 1,
              "destination": 2,
              "direction": 3,
              "action": 4,
              "match": 5,
              "Value": 6
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "verdicts",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "action"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "audit": {
                        "color": "orange",
                        "index": 0
                      },
                      "forwarded": {
                        "color": "green",
                        "index": 1
                      },
                      "dropped": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "description": "match = none means no allow rule matched (the default-deny decided: audit while observing, dropped when enforcing); l3-l4 / l3-only / l4-only / l7 name the rule kind that allowed the flow."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "POLICY_DENIED drops per second (hubble_drop_total)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(hubble_drop_total{cluster=~\"$cluster\", ${role}=~\"$namespace\", reason=\"POLICY_DENIED\"}[$__rate_interval])) by (source, destination)",
          "legendFormat": "{{source}} \u2192 {{destination}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "description": "Cilium's drop metric beside the verdict metric: the same enforcement seen by the datapath (reason POLICY_DENIED), per source \u2192 destination. The same drops the Network Overview and the Hubble Metrics 'Network Policy' row show \u2014 here beside the audit line, so the before/after of enforcement is one picture."
    },
    {
      "id": 9,
      "type": "row",
      "title": "Flows \u2014 every verdict Hubble saw (hubble_flows_processed_total)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Flows per second, by verdict",
      "description": "Every flow Hubble processed for the namespace (as ${role}), by verdict \u2014 FORWARDED, DROPPED, AUDIT, REDIRECTED, ERROR. The verdict panels above count POLICY decisions only; this is the whole traffic they sit in. From Cilium's Hubble / Network Overview (Namespace) dashboard, scoped by the same namespace filter as the rest of this page.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(hubble_flows_processed_total{cluster=~\"$cluster\", ${role}=~\"$namespace\"}[$__rate_interval])) by (verdict)",
          "legendFormat": "{{verdict}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Top 10 sources (flows per second)",
      "description": "The busiest sources among the namespace's flows (as ${role}), now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, sum(rate(hubble_flows_processed_total{cluster=~\"$cluster\", ${role}=~\"$namespace\"}[$__rate_interval])) by (source))",
          "legendFormat": "{{source}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 14,
          "valueSize": 16
        }
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Top 10 destinations (flows per second)",
      "description": "The busiest destinations among the namespace's flows (as ${role}), now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, sum(rate(hubble_flows_processed_total{cluster=~\"$cluster\", ${role}=~\"$namespace\"}[$__rate_interval])) by (destination))",
          "legendFormat": "{{destination}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 14,
          "valueSize": 16
        }
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Drops, every reason (hubble_drop_total)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Drops per second, by reason and protocol",
      "description": "All of Cilium's drop reasons for the namespace (as ${role}), not only POLICY_DENIED: a drop that is not a policy verdict (an unroutable address, a missing service backend, a conntrack miss) shows here and nowhere in the verdict panels. From Cilium's Hubble Metrics 'Network Policy' row and the Network Overview drops, in one panel.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(hubble_drop_total{cluster=~\"$cluster\", ${role}=~\"$namespace\"}[$__rate_interval])) by (reason, protocol)",
          "legendFormat": "{{reason}} ({{protocol}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Top 10 sources with dropped packets",
      "description": "Who is being dropped the most (any reason), now. The reason is on the timeseries to the left.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
